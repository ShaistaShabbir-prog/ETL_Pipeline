# ETL Pipeline — Environment Variables
# Copy to .env and fill in your values

# Database (required for PostgreSQL load)
DATABASE_URL=postgresql://user:password@localhost:5432/etl_db

# dbt profile (matches profiles.yml)
DBT_TARGET=dev

# Optional: Airflow
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# Optional: Great Expectations
GE_CLOUD_MODE=false
